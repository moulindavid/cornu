{
  "swagger": "2.0",
  "info": { "title": "Swagger Petstore", "version": "1.0.7" },
  "host": "petstore.swagger.io",
  "basePath": "/v2",
  "schemes": ["https", "http"],
  "consumes": ["application/json"],
  "tags": [{ "name": "pet" }, { "name": "user" }],
  "paths": {
    "/pet": {
      "put": {
        "tags": ["pet"],
        "summary": "Update an existing pet",
        "consumes": ["application/json", "application/xml"],
        "parameters": [
          { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/Pet" } }
        ],
        "security": [{ "petstore_auth": ["write:pets"] }]
      }
    },
    "/pet/{petId}": {
      "post": {
        "tags": ["pet"],
        "summary": "Updates a pet in the store with form data",
        "consumes": ["application/x-www-form-urlencoded"],
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "type": "integer" },
          { "name": "name", "in": "formData", "type": "string", "x-example": "rex" },
          { "name": "status", "in": "formData", "type": "string" }
        ]
      }
    },
    "/pet/{petId}/uploadImage": {
      "post": {
        "tags": ["pet"],
        "summary": "uploads an image",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "type": "integer" },
          { "name": "additionalMetadata", "in": "formData", "type": "string" },
          { "name": "file", "in": "formData", "type": "file" }
        ]
      }
    },
    "/user/login": {
      "get": {
        "tags": ["user"],
        "summary": "Logs user into the system",
        "parameters": [
          { "name": "username", "in": "query", "required": true, "type": "string" },
          { "name": "tags", "in": "query", "type": "array", "items": { "type": "string", "default": "a" } }
        ],
        "security": []
      }
    }
  },
  "security": [{ "basic": [] }],
  "securityDefinitions": {
    "basic": { "type": "basic" },
    "petstore_auth": {
      "type": "oauth2",
      "authorizationUrl": "https://petstore.swagger.io/oauth/authorize",
      "flow": "implicit"
    }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string", "example": "doggie" },
        "tags": { "type": "array", "items": { "$ref": "#/definitions/Tag" } }
      }
    },
    "Tag": {
      "type": "object",
      "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
    }
  }
}
